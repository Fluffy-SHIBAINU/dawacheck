{
  "name": "dawacheck",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "data:register": "tsx scripts/fetch-register.ts",
    "data:alerts": "tsx scripts/fetch-alerts.ts",
    "data:manifest": "tsx scripts/build-manifest.ts",
    "data": "npm run data:register && npm run data:alerts && npm run data:manifest",
    "build:e2e": "npm run assets && vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "assets": "tsx scripts/copy-ocr-assets.ts",
    "test:ocr": "vitest run --config vitest.ocr.config.ts",
    "voice": "tsx scripts/make-voice.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@playwright/test": "^1.63.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
